#cloud-config
package_update: true
packages:
  - curl
  - ca-certificates
  - jq
  - zstd
  - python3
  - python3-cryptography
  - caddy
write_files:
  - path: /etc/clave/env
    permissions: "0644"
    content: |
      CLAVE_VERSION=${clave_version}
      CLAVE_RELEASE_BASE_URL=${clave_release_base_url}
      CLAVE_TARGET=${clave_target}
      PUBLIC_HOSTNAME=${public_hostname}
      ACME_EMAIL=${acme_email}
      EPOCH_CADENCE_SECONDS=${epoch_cadence_seconds}
      PIN_SUFFIX_LIST=${pin_suffix_list}
  - path: /usr/local/sbin/clave-install
    permissions: "0755"
    content: |
      ${indent(6, clave_install)}
  - path: /usr/local/sbin/clave-backup
    permissions: "0755"
    content: |
      ${indent(6, clave_backup)}
  - path: /usr/local/sbin/clave-restore
    permissions: "0755"
    content: |
      ${indent(6, clave_restore)}
  - path: /usr/local/sbin/clave-verify
    permissions: "0755"
    content: |
      ${indent(6, clave_verify)}
  - path: /usr/local/lib/clave/verify-checkpoint.py
    permissions: "0644"
    content: |
      ${indent(6, verify_checkpoint)}
runcmd:
  - [/usr/local/sbin/clave-install]
final_message: "clave-install finished after $UPTIME seconds"
